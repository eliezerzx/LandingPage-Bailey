- */\n.infwc-modal {\n    position: relative;\n    width: 100%; max-width: 380px;\n    background: linear-gradient(160deg, #fff 0%, #fef9c3 100%);\n    border-radius: 22px;\n    padding: 28px 26px 22px;\n    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35), 0 0 0 6px rgba(255, 255, 255, 0.08);\n    text-align: center;\n    font-family: 'Manrope', system-ui, -apple-system, 'Segoe UI', sans-serif;\n    color: #15171a;\n    animation: infwc-pop-in .45s cubic-bezier(.34, 1.56, .64, 1);\n    overflow: hidden;\n}\n.infwc-modal::before {\n    content: \"\"; position: absolute; inset: 0;\n    background: radial-gradient(circle at 50% -20%, rgba(245, 158, 11, 0.25), transparent 50%);\n    pointer-events: none;\n}\n.infwc-modal-closing { animation: infwc-pop-out .2s ease-in forwards; }\n\n@keyframes infwc-pop-in {\n    0%   { transform: scale(.6) translateY(20px); opacity: 0; }\n    60%  { transform: scale(1.05) translateY(-4px); }\n    100% { transform: scale(1) translateY(0); opacity: 1; }\n}\n@keyframes infwc-pop-out {\n    from { transform: scale(1); opacity: 1; }\n    to   { transform: scale(.85); opacity: 0; }\n}\n\n.infwc-close {\n    position: absolute; top: 12px; right: 12px;\n    width: 30px; height: 30px; border-radius: 50%;\n    background: rgba(0, 0, 0, .06); color: #15171a;\n    border: none; cursor: pointer; font-size: 18px; font-weight: 700;\n    display: grid; place-items: center;\n    line-height: 1; padding: 0;\n    transition: background .12s;\n    z-index: 2;\n}\n.infwc-close:hover { background: rgba(0, 0, 0, .12); }\n\n/* ---------- Conteúdo ---------- */\n.infwc-emoji {\n    font-size: 56px; line-height: 1;\n    margin-bottom: 8px;\n    display: inline-block;\n    animation: infwc-bounce 1.8s ease-in-out infinite;\n    position: relative; z-index: 1;\n}\n@keyframes infwc-bounce {\n    0%, 100% { transform: translateY(0) rotate(-4deg); }\n    50%      { transform: translateY(-8px) rotate(4deg); }\n}\n\n.infwc-title {\n    font-size: 26px; font-weight: 800; letter-spacing: -.02em;\n    margin: 4px 0 6px;\n    background: linear-gradient(135deg, #dc2626, #f59e0b);\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n    position: relative; z-index: 1;\n}\n\n.infwc-sub {\n    margin: 0 0 18px;\n    font-size: 14px; color: #475569; font-weight: 500;\n    line-height: 1.5;\n    position: relative; z-index: 1;\n}\n\n/* ---------- Cupom box ---------- */\n.infwc-coupon-box {\n    position: relative; z-index: 1;\n    background: linear-gradient(135deg, #fef3c7, #fbbf24);\n    border: 2px dashed #b45309;\n    border-radius: 14px;\n    padding: 14px 16px;\n    margin-bottom: 18px;\n}\n.infwc-coupon-label {\n    font-size: 11px; font-weight: 800; letter-spacing: .08em;\n    text-transform: uppercase; color: #92400e;\n    margin-bottom: 4px;\n}\n.infwc-coupon-code {\n    font-family: 'JetBrains Mono', 'Courier New', monospace;\n    font-size: 26px; font-weight: 800; letter-spacing: .02em;\n    color: #7c2d12; line-height: 1.1;\n    text-shadow: 0 1px 0 rgba(255, 255, 255, .5);\n}\n.infwc-coupon-hint {\n    margin-top: 8px;\n    font-size: 12px; color: #92400e; font-weight: 600;\n    line-height: 1.4;\n}\n\n/* ---------- CTA ---------- */\n.infwc-cta {\n    position: relative; z-index: 1;\n    width: 100%; height: 50px;\n    border: none; border-radius: 14px;\n    background: linear-gradient(135deg, #dc2626, #b91c1c);\n    color: #fff; font-weight: 800; font-size: 16px;\n    cursor: pointer; font-family: inherit;\n    box-shadow: 0 8px 20px rgba(220, 38, 38, .35);\n    transition: transform .12s, box-shadow .12s;\n}\n.infwc-cta:hover  { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(220, 38, 38, .45); }\n.infwc-cta:active { transform: translateY(0); }\n\n/* ---------- Confetti ---------- */\n.infwc-confetti {\n    position: absolute; inset: 0; pointer-events: none;\n    overflow: hidden;\n}\n.infwc-confetti-piece {\n    position: absolute; top: -20px;\n    width: 10px; height: 14px;\n    background: #f59e0b;\n    animation: infwc-fall 3.2s linear infinite;\n    opacity: .9;\n    border-radius: 2px;\n}\n.infwc-confetti-piece.c0 { background: #dc2626; }\n.infwc-confetti-piece.c1 { background: #f59e0b; }\n.infwc-confetti-piece.c2 { background: #16a34a; transform: rotate(20deg); }\n.infwc-confetti-piece.c3 { background: #3b82f6; transform: rotate(-15deg); }\n.infwc-confetti-piece.c4 { background: #ec4899; transform: rotate(45deg); }\n.infwc-confetti-piece.c5 { background: #a855f7; }\n\n@keyframes infwc-fall {\n    0%   { top: -20px;  transform: rotate(0)    translateX(0); opacity: 1; }\n    50%  { opacity: 1; }\n    100% { top: 110vh;  transform: rotate(720deg) translateX(40px); opacity: 0; }\n}\n\n/* ---------- Mobile ---------- */\n@media (max-width: 380px) {\n    .infwc-modal      { padding: 22px 20px 18px; }\n    .infwc-emoji      { font-size: 48px; }\n    .infwc-title      { font-size: 22px; }\n    .infwc-coupon-code { font-size: 22px; }\n}\n","",{version:3,sources:["webpack://resources/js/system/components/InfluencerWelcome/styles.css"],names:[],mappings:"AAAA;;;iEAGiE;;AAEjE;IACI,eAAe,EAAE,QAAQ,EAAE,cAAc;IACzC,kCAAkC;IAClC,0BAA0B;IAC1B,kCAAkC;IAClC,aAAa,EAAE,mBAAmB,EAAE,uBAAuB;IAC3D,aAAa;IACb,qCAAqC;AACzC;AACA,+BAA+B,+CAA+C,EAAE;;AAEhF,4BAA4B,OAAO,UAAU,EAAE,EAAE,KAAK,UAAU,EAAE,EAAE;AACpE,4BAA4B,OAAO,UAAU,EAAE,EAAE,KAAK,UAAU,EAAE,EAAE;;AAEpE,oCAAoC;AACpC;IACI,kBAAkB;IAClB,WAAW,EAAE,gBAAgB;IAC7B,0DAA0D;IAC1D,mBAAmB;IACnB,uBAAuB;IACvB,gFAAgF;IAChF,kBAAkB;IAClB,wEAAwE;IACxE,cAAc;IACd,4DAA4D;IAC5D,gBAAgB;AACpB;AACA;IACI,WAAW,EAAE,kBAAkB,EAAE,QAAQ;IACzC,0FAA0F;IAC1F,oBAAoB;AACxB;AACA,uBAAuB,6CAA6C,EAAE;;AAEtE;IACI,OAAO,qCAAqC,EAAE,UAAU,EAAE;IAC1D,OAAO,uCAAuC,EAAE;IAChD,OAAO,iCAAiC,EAAE,UAAU,EAAE;AAC1D;AACA;IACI,OAAO,mBAAmB,EAAE,UAAU,EAAE;IACxC,OAAO,qBAAqB,EAAE,UAAU,EAAE;AAC9C;;AAEA;IACI,kBAAkB,EAAE,SAAS,EAAE,WAAW;IAC1C,WAAW,EAAE,YAAY,EAAE,kBAAkB;IAC7C,8BAA8B,EAAE,cAAc;IAC9C,YAAY,EAAE,eAAe,EAAE,eAAe,EAAE,gBAAgB;IAChE,aAAa,EAAE,mBAAm