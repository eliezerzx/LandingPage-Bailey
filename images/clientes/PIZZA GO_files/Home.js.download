ding: 10px;\n    background-color: #ffffff;\n    border-radius: 6px;\n    flex-direction: column;\n    gap: 10px;\n    z-index: 999;\n}\n\n.aside_cart-title {\n    text-transform: uppercase;\n    font-weight: 500;\n    font-size: 20px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n}\n\n.aside_cart-product_list {\n    display: flex;\n    flex-direction: column;\n    overflow: auto;\n}\n\n.aside_cart-product_card {\n    border-bottom: 1px dashed #99999980;\n    padding-bottom: 10px;\n    margin-bottom: 10px;\n    display: flex;\n    gap: 10px;\n}\n\n.aside_cart-product_card:last-child {\n    margin-bottom: 0;\n}\n\n.aside_cart-product_infos {\n    flex-grow: 1;\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n}\n\n#aside_cart .product_picture {\n    border-radius: 6px;\n}\n\n.aside_cart-product_name_price {\n    display: flex;\n    justify-content: space-between;\n    gap: 5px;\n}\n\n.aside_cart-product_name {\n    flex-grow: 1;\n    text-transform: uppercase;\n    font-weight: 500;\n}\n\n.aside_cart-product_price {\n    flex-shrink: 0;\n    font-weight: 500;\n}\n\n.aside_cart-additional_list {\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n}\n\n#aside_cart #demand {\n    position: static;\n    box-shadow: none;\n    padding: 0;\n    margin-bottom: 0 !important;\n}\n\n#aside_cart #demand button {\n    width: 100%;\n    padding: 0 0 0 8px;\n}\n\n#aside_cart #demand .text span {\n    text-align: left;\n}\n\n#aside_cart #demand .price {\n    font-size: 14px;\n}\n"],sourceRoot:""}]),e.default=r},Oipx:function(n,e,t){var a=t("LboF"),r=t("owVc");"string"==typeof(r=r.__esModule?r.default:r)&&(r=[[n.i,r,""]]);var o={insert:"head",singleton:!1};a(r,o);n.exports=r.locals||{}},OmuU:function(n,e,t){"use strict";t.r(e);var a=t("JPst"),r=t.n(a)()(!0);r.push([n.i,'.background-redo_order-modal {\n    background: rgba(0, 0, 0, 0.5);\n    width: 100%;\n    height: 100%;\n    position: fixed;\n    top: 0;\n    left: 0;\n    z-index: 9999;\n}\n\n.redo_order-modal {\n    background: #ffffff;\n    width: calc(100% - 40px);\n    max-width: 500px;\n    max-height: 80vh;\n    height: auto;\n    padding: 20px;\n    border-radius: 6px;\n    top: 50%;\n    left: 50%;\n    position: fixed;\n    transform: translate(-50%, -50%);\n    z-index: 99999;\n}\n\n.redo_order-modal ul {\n    list-style: none;\n}\n\n.redo_order-modal-header {\n    background: #ffffff;\n    color: black;\n    width: 100%;\n    margin: 0 0 20px 0;\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    text-transform: uppercase;\n    font-weight: 600;\n    font-size: 18px;\n}\n\n@media (max-width: 350px) {\n    .redo_order-modal-header {\n        font-size: 16px;\n    }\n}\n\n.redo_order-modal-header > svg {\n    background-color: #f44336;\n    color: #ffffff;\n    border-radius: 4px;\n    padding: 3px;\n    cursor: pointer;\n}\n\n.redo_order-modal-main {\n    max-height: calc(80vh - 85px);\n    overflow-y: auto;\n    scrollbar-color: #5b5b5b7a transparent;\n}\n\n.redo_order-modal-desc {\n    background-color: #0000000a;\n    padding: 2px 4px;\n    border-radius: 4px;\n    border: 1px solid #00000010;\n    font-size: 15px;\n    margin-bottom: 10px;\n}\n\n.redo_order-modal-infos {\n    margin-bottom: 10px;\n    font-size: 14px;\n}\n\n.redo_order-modal .redo_order-modal-input {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 5px;\n    padding: 10px;\n}\n\n.redo_order-modal .redo_order-modal-input input {\n    width: 160px;\n    height: 100%;\n    border: 1px solid rgba(0, 0, 0, 0.2);\n    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);\n    border-radius: 4px;\n    padding: 6px;\n}\n\n.redo_order-modal\n    .redo_order-modal-input\n    input[type="number"]::-webkit-inner-spin-button {\n    appearance: none;\n}\n\n.redo_order-modal-btn {\n    width: 100%;\n    height: 43px;\n    background-color: #4caf50;\n    border-radius: 4px;\n    border: 1px solid rgba(0, 0, 0, 0.1);\n    box-shadow: 0 1px 10px rgba(0, 0, 0, 0.05);\n    padding: 0 12px;\n    color: #fff;\n    margin: 15px auto 0;\n}\n\n.orders_loading > svg {\n    height: 25px;\n    width: 25px;\n    fill: #ed0407;\n}\n\n.redo_order-modal-order {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 4px;\n    margin: 0;\n    padding: 0;\n    background-color: #ffffff80;\n    border: 1px solid #ed0407;\n    border-radius: 6px;\n}\n\n.redo_order-modal-order > strong {\n    text-align: center;\n    font-weight: 500;\n    color: #ffffff;\n    font-size: 15px;\n    background-color: #ed0407;\n    padding: 2px 4px;\n    margin: 0;\n    border-radius: 6px 6px 0 0;\n}\n\n.redo_order-modal-purchase {\n    font-size: 15px;\n    padding: 0 6px;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    margin: 0;\n}\n\n.redo_order-modal-purchase > li {\n    padding-bottom: 4px;\n    display: flex;\n    gap: 10px;\n}\n\n.redo_order-modal-purchase > li:not(:last-child) {\n    border-bottom: 1px dashed #99999980;\n}\n\n.product_picture {\n    flex-shrink: 0;\n    width: 75px;\n    height: 75px;\n    border-radius: 4px;\n    border: 1px solid #00000010;\n    background-repeat: no-repeat;\n    background-position: center;\n    background-size: cover;\n}\n\n.redo_order-modal-product_infos {\n    display: flex;\n    justify-content: space-between;\n    gap: 15px;\n}\n\n.redo_order-modal-product_infos.disabled {\n    flex-direction: column;\n    justify-content: flex-start;\n    gap: 0;\n    background-color: #0000000a;\n    padding: 0 4px;\n    border-radius: 4px;\n    border: 1px solid #00000010;\n}\n\n.redo_order-modal-product_infos.disabled > s {\n    opacity: 0.8;\n}\n\n.redo_order-modal-product_aditionals {\n    display: flex;\n    flex-direction: column;\n    margin: 0;\n    padding: 0 0 0 20px;\n}\n\n.redo_order-modal-purchase_btn {\n    color: #ffffff;\n    text-align: center;\n    border-radius: 0 0 4px 4px;\n    border-top: solid 1px;\n    padding: 6px;\n    cursor: pointer;\n    transition: all 300ms ease-in-out;\n}\n\n.redo_order-modal-notice {\n    display: flex;\n    align-items: center;\n    gap: 5px;\n    line-height: 1;\n}\n\n.redo_order-modal-notice > svg {\n    color: #ed0407;\n    flex-shrink: 0;\n}\n\n.redo_order-modal-login_button {\n    color: #ffffff;\n    text-align: center;\n    font-weight: 500;\n    padding: 12px;\n    margin-top: 15px;\n    border-radius: 4px;\n    cursor: pointer;\n}\n',"",{version:3,sources:["webpack://resources/js/system/components/redoOrderModalMenu/style.css"],names:[],mappings:"AAAA;IACI,8BAA8B;IAC9B,WAAW;IACX,YAAY;IACZ,eAAe;IACf,MAAM;IACN,OAAO;IACP,aAAa;AACjB;;AAEA;IACI,mBAAmB;IACnB,wBAAwB;IACxB,gBAAgB;IAChB,gBAAgB;IAChB,YAAY;IACZ,aAAa;IACb,kBAAkB;IAClB,QAAQ;IACR,SAAS;IACT,eAAe;IACf,gCAAgC;IAChC,cAAc;AAClB;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,mBAAmB;IACnB,YAAY;IACZ,WAAW;IACX,kBAAkB;IAClB,kBAAkB;IAClB,aAAa;IACb,mBAAmB;IACnB,8BAA8B;IAC9B,yBAAyB;IACzB,gBAAgB;IAChB,eAAe;AACnB;;AAEA;IACI;QACI,eAAe;IACnB;AACJ;;AAEA;IACI,yBAAyB;IACzB,cAAc;IACd,kBAAkB;IAClB,YAAY;IACZ,eAAe;AACnB;;AAEA;IACI,6BAA6B;IAC7B,gBAAgB;IAChB,sCAAsC;AAC1C;;AAEA;IACI,2BAA2B;IAC3B,gBAAgB;IAChB,kBAAkB;IAClB,2BAA2B;IAC3B,eAAe;IACf,mBAAmB;AACvB;;AAEA;IACI,mBAAmB;IACnB,eAAe;AACnB;;AAEA;IACI,aAAa;IACb,mBAAmB;IACnB,uBAAuB;IACvB,QAAQ;IACR,aAAa;AACjB;;AAEA;IACI,YAAY;IACZ,YAAY;IACZ,oCAAoC;IACpC,wCAAwC;IACxC,kBAAkB;IAClB,YAAY;AAChB;;AAEA;;;IAGI,gBAAgB;AACpB;;AAEA;IACI,WAAW;IACX,YAAY;IACZ,yBAAyB;IACzB,kBAAkB;IAClB,oCAAoC;IACpC,0CAA0C;IAC1C,eAAe;IACf,WAAW;IACX,mBAAmB;AACvB;;AAEA;IACI,YAAY;IACZ,WAAW;IACX,aAAa;AACjB;;AAEA;IACI,aAAa;IACb,sBAAsB;IACtB,uBAAuB;IACvB,QAAQ;IACR,SAAS;IACT,UAAU;IACV,2BAA2B;IAC3B,yBAAyB;IACzB,kBAAkB;AACtB;;AAEA;IACI,kBAAkB;IAClB,gBAAgB;IAChB,cAAc;IACd,eAAe;IACf,yBAAyB;IACzB,gBAAgB;IAChB,SAAS;IACT,0BAA0B;AAC9B;;AAEA;IACI,eAAe;IACf,cAAc;IACd,aAAa;IACb,sBAAsB;IACtB,QAAQ;IACR,SAAS;AACb;;AAEA;IACI,mBAAmB;IACnB,aAAa;IACb,SAAS;AACb;;AAEA;IACI,mCAA