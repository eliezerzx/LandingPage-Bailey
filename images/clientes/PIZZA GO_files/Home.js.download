ght: 6px;\n}\n\n.features_buttons {\n    display: flex;\n    /* flex-direction: column; */\n    gap: 10px;\n    justify-content: space-between;\n    align-items: stretch;\n    margin-bottom: 15px;\n    width: 100%;\n}\n\n@media (max-width: 390px) {\n    .features_buttons {\n        margin-bottom: 10px;\n    }\n\n    .features_buttons:first-of-type {\n        margin-top: -10px;\n    }\n}\n\n.redo_order-button > p,\n.cashback-button > p,\n.features_buttons #open-fidelity_system {\n    font-size: 13px;\n    text-align: center;\n}\n\n.features_buttons #open-fidelity_system {\n    margin: 0;\n    padding: 12px 8px;\n    width: initial;\n    flex-grow: 1;\n}\n\n.redo_order-button {\n    cursor: pointer;\n    background-color: #ffffff;\n    padding: 12px 8px;\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 2px;\n    flex-grow: 1;\n}\n\n.redo_order-button > p {\n    text-transform: uppercase;\n    font-weight: 500;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n}\n\n.redo_order-button svg,\n.features_buttons #open-fidelity_system > svg {\n    width: 20px;\n    height: 20px;\n}\n\n@media (max-width: 400px) {\n    .redo_order-button > p,\n    .cashback-button > p,\n    .features_buttons #open-fidelity_system {\n        font-size: 12px;\n        text-align: center;\n    }\n\n    .redo_order-button svg,\n    .cashback-button svg,\n    .features_buttons #open-fidelity_system > svg {\n        width: 15px;\n        height: 15px;\n    }\n}\n\n.background-storeStatus-modal {\n    background: rgba(0, 0, 0, 0.5);\n    width: 100%;\n    height: 100%;\n    position: fixed;\n    top: 0;\n    left: 0;\n    z-index: 99999;\n}\n\n.storeStatus-modal {\n    width: calc(100% - 40px);\n    height: auto;\n    padding: 20px;\n    border-radius: 6px;\n    top: 50%;\n    left: 50%;\n    position: fixed;\n    transform: translate(-50%, -50%);\n    z-index: 999999;\n}\n\n.storeStatus-modal.red {\n    background: #f44336;\n}\n\n.storeStatus-modal.yellow {\n    background: #e27006;\n}\n\n.storeStatus-modal-close {\n    background: #f44336;\n    float: right;\n    margin-right: -20px;\n    margin-top: -60px;\n    padding: 7.5px 15px;\n    border-radius: 6px;\n    font-weight: bold;\n    color: white;\n    cursor: pointer;\n}\n\n.storeStatus-modal-header {\n    color: white;\n    width: 100%;\n    margin: 10px 0 20px;\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: bold;\n    text-transform: uppercase;\n}\n\n.storeStatus-modal-header > svg {\n    margin-right: 20px;\n}\n\n.storeStatus-modal-info {\n    background-color: rgba(0, 0, 0, 0.1);\n    color: #ffffff;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    padding: 10px;\n    border-radius: 2px;\n}\n\n.storeStatus-modal-btn {\n    background-color: rgba(0, 0, 0, 0.1);\n    color: #ffffff;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    width: 100%;\n    gap: 6px;\n    margin-top: 15px;\n    padding: 10px;\n    border-radius: 2px;\n    cursor: pointer;\n}\n\n#aside_cart {\n    display: none;\n}\n\nfooter {\n    display: flex;\n    align-items: center;\n    flex-direction: column;\n    padding: 20px;\n    margin-top: -60px;\n}\n\nfooter a {\n    margin-top: 10px;\n    padding: 6px 12px;\n    border-radius: 6px;\n    border: 1px solid rgba(0, 0, 0, 0.1);\n    background-color: rgba(0, 0, 0, 0.25);\n    color: #ffffff;\n    text-decoration: none;\n    font-size: 14px;\n    transition: all 0.3s ease-in-out;\n}\n\nfooter a:visited {\n    color: #ffffff;\n    text-decoration: none;\n}\n\nfooter a:hover {\n    border: 1px solid rgba(0, 0, 0, 0.25);\n    background-color: rgba(0, 0, 0, 0.4);\n    transform: scale(1.025);\n}\n\nfooter a:active {\n    border: 1px solid rgba(0, 0, 0, 0.25);\n    background-color: rgba(0, 0, 0, 0.4);\n    transform: scale(0.975);\n}\n\n@media (min-width: 1200px) {\n    /* #main-nav {\n        max-width: 80vw;\n        min-width: 1200px;\n        margin: 0 auto;\n    } */\n\n    #demand {\n        display: none;\n    }\n\n    #home-main {\n        display: flex;\n        box-sizing: border-box;\n        max-width: 80vw;\n        min-width: 1200px;\n        margin: 0 auto;\n        padding: 0;\n        position: relative;\n    }\n\n    #home-main .main_container {\n        width: calc(100% - 377px - 10px);\n    }\n\n    #aside_cart {\n        flex-shrink: 0;\n        display: flex;\n    }\n\n    #aside_cart #demand {\n        display: initial;\n    }\n\n    .desktop-header {\n        display: block;\n        box-sizing: border-box;\n        max-width: 80vw;\n        min-width: 1200px;\n        margin: 0 auto;\n    }\n\n    footer {\n        margin-top: 20px;\n        margin-bottom: 20px !important;\n    }\n}\n\n.modern-header,\n.default-header,\n.desktop-header,\n.tablet-header {\n    display: none;\n}\n\n@media (min-width: 700px) and (orientation: landscape) {\n    .list-vertical {\n        display: grid;\n        grid-template-columns: repeat(2, 1fr);\n        gap: 10px;\n    }\n\n    main > .main_container > .main_content {\n        display: flex;\n        position: relative;\n    }\n\n    main > .main_container > .search-bar {\n        height: fit-content;\n        z-index: 99;\n        position: sticky;\n        top: 15px;\n    }\n\n    main > .main_container > .main_content > .categories_nav_bar {\n        flex-shrink: 0;\n        z-index: 99;\n    }\n\n    main > .main_container > .main_content > .categories_nav_bar > div {\n        position: sticky;\n        top: 70px;\n    }\n\n    main > .main_container > .main_content > .categories_list {\n        width: calc(100vw - 200px);\n        margin-left: 15px;\n    }\n\n    .category > .swiper-container > .swiper-wrapper {\n        flex-direction: column;\n        width: 140px;\n        max-height: calc(100vh - 85px);\n        max-height: calc(100vh - 150px);\n    }\n\n    .max-height-minus-