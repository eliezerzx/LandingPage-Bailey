ckground: #ffffff;\n    color: black;\n    width: 100%;\n    margin: 0 0 20px 0;\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    text-transform: uppercase;\n    font-weight: 600;\n    font-size: 18px;\n}\n\n@media (max-width: 350px) {\n    #fidelity_system-modal .fidelity_system-modal-header {\n        font-size: 16px;\n    }\n}\n\n#fidelity_system-modal .fidelity_system-modal-header svg {\n    background-color: #f44336;\n    color: #ffffff;\n    border-radius: 4px;\n    padding: 3px;\n    cursor: pointer;\n}\n\n#fidelity_system-modal .fidelity_image-container {\n    width: 100px;\n    height: 100px;\n    margin: 0 auto 10px;\n}\n\n#fidelity_system-modal .fidelity_image-container + p {\n    text-align: center;\n    font-size: 14px;\n    font-weight: 500;\n    margin: 0 0 10px;\n}\n\n#fidelity_system-modal .fidelity_system-list {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    max-height: 50vh;\n    overflow-y: scroll;\n}\n\n#fidelity_system-modal .fidelity_system-modal-btn {\n    width: 100%;\n    height: 43px;\n    border-radius: 4px;\n    border: 1px solid rgba(0, 0, 0, 0.1);\n    box-shadow: 0 1px 10px rgba(0, 0, 0, 0.05);\n    padding: 0 12px;\n    color: #ffffff;\n    margin: 10px auto 0;\n}\n\n#fidelity_system-modal .fidelity_info {\n    display: block;\n    padding: 10px;\n    margin-top: 10px;\n    font-size: 13px;\n    font-weight: 400;\n    border-radius: 4px;\n    width: 100%;\n    text-align: left;\n    color: rgba(68, 68, 68, 1);\n    background-color: #f5f5f5;\n    border: 1px solid #e3e3e3;\n    box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.05);\n}\n\n#fidelity_system-modal .action_buttons {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    font-size: 14px;\n    margin: 20px 0 0;\n}\n\n#fidelity_system-modal .action_buttons button {\n    cursor: pointer;\n    border: none;\n    transition: 0.2s;\n    padding: 8px 16px;\n 