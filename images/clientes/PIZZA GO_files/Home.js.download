on(n,e,t){"use strict";t.r(e);var a=t("JPst"),r=t.n(a)()(!0);r.push([n.i,"header {\n    height: 300px;\n    display: flex;\n    justify-content: center;\n    margin-bottom: 28px;\n}\n\nheader .logo {\n    width: 192px;\n    height: 192px;\n    background-color: var(--white);\n    border-radius: 8px;\n    background-position: center;\n    background-repeat: no-repeat;\n    background-size: 60%;\n    margin-top: 136px;\n    border: 1px solid rgba(0, 0, 0, 0.1);\n    box-shadow: 0 1px 10px rgba(0, 0, 0, 0.05);\n}\n\n.desktop-header header {\n    height: 300px;\n    margin-bottom: 0;\n}\n\n.desktop-header .informations {\n    height: fit-content;\n    width: 100%;\n    background: white;\n    box-shadow: 0 1px 10px rgba(0, 0, 0, 0.05);\n    margin-bottom: 15px;\n    padding: 10px;\n    border-radius: 0 0 6px 6px;\n    display: flex;\n    flex-direction: column;\n    position: relative;\n}\n\n@media (min-width: 600px) {\n    .desktop-header .informations {\n        max-width: 100%;\n    }\n}\n\n.desktop-header .informations .header-infos {\n    display: flex;\n    align-items: flex-end;\n    column-gap: 10px;\n    width: 100%;\n    max-width: 390px;\n}\n\n@media (min-width: 600px) {\n    .desktop-header .informations .header-infos {\n        max-width: 100%;\n    }\n}\n\n.desktop-header .informations .header-infos .logo {\n    width: 95px;\n    height: 95px;\n    border-radius: 16px;\n    border: 4px solid #ffffff;\n    background-position: center;\n    background-repeat: no-repeat;\n    background-size: cover;\n    margin-top: -30px;\n    background-color: white;\n    flex-shrink: 0;\n}\n\n.desktop-header .informations .header-infos .text {\n    display: flex;\n    flex-direction: column;\n    gap: 5px;\n    width: 500px;\n}\n\n.desktop-header .informations .header-infos .text .name {\n    font-weight: 500;\n}\n\n.desktop-header .informations .header-infos .text .description {\n    font-size: 13px;\n    opacity: 0.5;\n    min-height: 30px;\n}\n\n.desktop-header .informations .time_status {\n    font-weight: 400;\n    font-size: 14px;\n    text-wrap: nowrap;\n    margin-bottom: 5px;\n    gap: 10px;\n    display: flex;\n    flex-direction: column;\n    height: 100%;\n}\n\n.desktop-header .informations .time_status .status {\n    display: flex;\n    flex-direction: row;\n    align-items: center;\n    justify-content: space-between;\n}\n\n@media (min-width: 600px) {\n    .desktop-header .informations .time_status .status {\n        justify-content: flex-start;\n        gap: 25px;\n    }\n}\n\n.desktop-header .informations .status.open {\n    color: var(--green);\n}\n\n.desktop-header .informations .status.open .time {\n    background-color: #9eff9e;\n    color: #007900;\n    font-weight: 500;\n    padding: 2px 5px;\n    border-radius: 4px;\n    text-align: center;\n}\n\n.desktop-header .informations .status.close {\n    color: #f44336;\n}\n\n.desktop-header .informations .status.close .time {\n    background-color: #ff9d92;\n    color: #b90d00;\n    font-weight: 500;\n    padding: 2px 5px;\n    border-radius: 4px;\n    text-align: center;\n}\n\n.desktop-header .time_status strong {\n    font-weight: 600;\n}\n\n.desktop-header .informations .delivery_time {\n    font-weight: 500;\n    font-size: 15px;\n    display: flex;\n    gap: 10px;\n    align-items: center;\n    opacity: 0.5;\n}\n\n.desktop-header .informations .delivery_time svg {\n    width: 18px;\n    height: 18px;\n}\n","",{version:3,sources:["webpack://resources/js/system/components/Header/Layout/DesktopHeader/style.css"],names:[],mappings:"AAAA;IACI,aAAa;IACb,aAAa;IACb,uBAAuB;IACvB,mBAAmB;AACvB;;AAEA;IACI,YAAY;IACZ,aAAa;IACb,8BAA8B;IAC9B,kBAAkB;IAClB,2BAA2B;IAC3B,4BAA4B;IAC5B,oBAAoB;IACpB,iBAAiB;IACjB,oCAAoC;IACpC,0CAA0C;AAC9C;;AAEA;IACI,aAAa;IACb,gBAAgB;AACpB;;AAEA;IACI,mBAAmB;IACnB,WAAW;IACX,iBAAiB;IACjB,0CAA0C;IAC1C,mBAAmB;IACnB,aAAa;IACb,0BAA0B;IAC1B,aAAa;IACb,sBAAsB;IACtB,kBAAkB;AACtB;;AAEA;IACI;QACI,eAAe;IACnB;AACJ;;AAEA;IACI,aAAa;IACb,qBAAqB;IACrB,gBAAgB;IAChB,WAAW;IA