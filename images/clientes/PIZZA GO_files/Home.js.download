r-input {\n    /* width: 50%; */\n    height: 36px;\n    padding: 5px 12px;\n    padding-right: 2px;\n    border-radius: 5px;\n}\n\n#filter_bar-container .filter-search-bar {\n    display: flex;\n    align-items: center;\n    height: 38px;\n    max-width: 50%;\n    background-color: var(--white);\n    border-radius: 5px;\n    border: 1px solid rgba(0, 0, 0, 0.2);\n    padding-right: 6px;\n}\n\n.features_buttons {\n    display: flex;\n    /* flex-direction: column; */\n    gap: 10px;\n    justify-content: space-between;\n    align-items: stretch;\n    margin-bottom: 15px;\n    width: 100%;\n}\n\n@media (max-width: 390px) {\n    .features_buttons {\n        margin-bottom: 10px;\n    }\n\n    .features_buttons:first-of-type {\n        margin-top: -10px;\n    }\n}\n\n.redo_order-button > p,\n.cashback-button > p,\n.features_buttons #open-fidelity_system {\n    font-size: 13px;\n    text-align: center;\n}\n\n.features_buttons #open-fidelity_system {\n    margin: 0;\n    padding: 12px 8px;\n    width: initial;\n    flex-grow: 1;\n}\n\n.redo_order-button {\n    cursor: pointer;\n    background-color: #ffffff;\n    padding: 12px 8px;\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 2px;\n    flex-grow: 1;\n}\n\n.redo_order-button > p {\n    text-transform: uppercase;\n    font-weight: 500;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n}\n\n.redo_order-button svg,\n.features_buttons #open-fidelity_system > svg {\n    width: 20px;\n    height: 20px;\n}\n\n@media (max-width: 400px) {\n    .redo_order-button > p,\n    .cashback-button > p,\n    .features_buttons #open-fidelity_system {\n        font-size: 12px;\n        text-align: center;\n    }\n\n    .redo_order-button svg,\n    .cashback-button svg,\n    .features_buttons #open-fidelity_system > svg {\n        width: 15px;\n        height: 15px;\n    }\n}\n\n.background-storeStatus-modal {\n    background: rgba(0, 0, 0, 0.5);\n    width: 100%;\n    height: 100%;\n    position: fixed;\n    top: 0;\n    left: 0;\n    z-index: 99999;\n}\n\n.storeStatus-modal {\n    width: calc(100% - 40px);\n    height: auto;\n    padding: 20px;\n    border-radius: 6px;\n    top: 50%;\n    left: 50%;\n    position: fixed;\n    transform: translate(-50%, -50%);\n    z-index: 999999;\n}\n\n.storeStatus-modal.red {\n    background: #f44336;\n}\n\n.storeStatus-modal.yellow {\n    background: #e27006;\n}\n\n.storeStatus-modal-close {\n    background: #f44336;\n    float: right;\n    margin-right: -20px;\n    margin-top: -60px;\n    padding: 7.5px 15px;\n    border-radius: 6px;\n    font-weight: bold;\n    color: white;\n    cursor: pointer;\n}\n\n.storeStatus-modal-header {\n    color: white;\n    width: 100%;\n    margin: 10px 0 20px;\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: bold;\n    text-transform: uppercase;\n}\n\n.storeStatus-modal-header > svg {\n    margin-right: 20px;\n}\n\n.storeStatus-modal-info {\n    background-color: rgba(0, 0, 0, 0.1);\n    color: #ffffff;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    padding: 10px;\n    border-radius: 2px;\n}\n\n.storeStatus-modal-btn {\n    background-color: rgba(0, 0, 0, 0.1);\n    color: #ffffff;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    width: 100%;\n    gap: 6px;\n    margin-top: 15px;\n    padding: 10px;\n    border-radius: 2px;\n    cursor: pointer;\n}\n\n#aside_cart {\n    display: none;\n}\n\nfooter {\n    display: flex;\n    align-items: center;\n    flex-direction: column;\n    padding: 20px;\n    margin-top: -60px;\n}\n\nfooter a {\n    margin-top: 10px;\n    padding: 6px 12px;\n    border-radius: 6px;\n    border: 1px solid rgba(0, 0, 0, 0.1);\n    background-color: rgba(0, 0, 0, 0.25);\n    color: #ffffff;\n    text-decoration: none;\n    font-size: 14px;\n    transition: all 0.3s ease-in-out;\n}\n\nfooter a:visited {\n    color: #ffffff;\n    text-decoration: none;\n}\n\nfooter a:hover {\n    border: 1px solid rgba(0, 0, 0, 0.25);\n    background-color: rgba(0, 0, 0, 0.4);\n    transform: scale(1.025);\n}\n\nfooter a:active {\n    border: 1px solid rgba(0, 0, 0, 0.25);\n    background-color: rgba(0, 0, 0, 0.4);\n    transform: scale(0.975);\n}\n\n@media (min-width: 1200px) {\n    /* #main-nav {\n        max-width: 80vw;\n        min-width: 1200px;\n        margin: 0 auto;\n    } */\n\n    #demand {\n        display: none;\n    }\n\n    #home-main {\n        display: flex;\n        box-sizing: border-box;\n        max-width: 80vw;\n        min-width: 1200px;\n        margin: 0 auto;\n        padding: 0;\n        position: relative;\n    }\n\n    #home-main .main_container {\n        width: calc(100% - 377px - 10px);\n    }\n\n    #aside_cart {\n        flex-shrink: 0;\n        display: flex;\n    }\n\n    #aside_cart #demand {\n        display: initial;\n    }\n\n    .desktop-header {\n        display: block;\n        box-sizing: border-box;\n        max-width: 80vw;\n        min-width: 1200px;\n        margin: 0 auto;\n    }\n\n    footer {\n        margin-top: 20px;\n        margin-bottom: 20px !important;\n    }\n}\n\n.modern-header,\n.default-header,\n.desktop-header,\n.tablet-header {\n    display: none;\n}\n\n@media (min-width: 700px) and (orientation: landscape) {\n    .list-vertical {\n        display: grid;\n        grid-template-columns: repeat(2, 1fr);\n        gap: 10px;\n    }\n\n    main > .main_container > .main_content {\n        display: flex;\n        position: relative;\n    }\n\n    main > .main_container > .search-bar {\n        height: fit-content;\n        z-index: 99;\n        position: sticky;\n        top: 15px;\n    }\n\n    main > .main_container > .main_content > .categories_nav_bar {\n        flex-shrink: 0;\n        z-index: 99;\n    }\n\n    main > .main_container > .main_content > .categories_nav_bar > div {\n        position: sticky;\n        top: 70px;\n    }\n\n    main > .main_container > .main_content > .categories_list {\n        width: calc(100vw - 200px);\n        margin-left: 15px;\n    }\n\n    .category > .swiper-container > .swiper-wrapper {\n        flex-direction: column;\n        width: 140px;\n        max-height: calc(100vh - 85px);\n        max-height: calc(100vh - 150px);\n    }\n\n    .max-height-minus-85 .category > .swiper-container > .swiper-wrapper {\n        max-height: calc(100vh - 85px);\n    }\n\n    .max-height-minus-150 .category > .swiper-container > .swiper-wrapper {\n        max-height: calc(100vh - 150px);\n    }\n}\n"],sourceRoot:""}]),e.default=r},JoNN:function(n,e,t){"use strict";var a=t("q1tI"),r=t.n(a),o=t("17x9"),i=t.n(o);function A(){return(A=Object.assign||function(n){for(var e=1;e<arguments.length;e++){var t=arguments[e];for(var a in t)Object.prototype.hasOwnProperty.call(t,a)&&(n[a]=t[a])}return n}).apply(this,arguments)}function l(n,e){if(null==n)return{};var t,a,r=function(n,e){if(null==n)return{};var t,a,r={},o=Object.keys(n);for(a=0;a<o.length;a++)t=o[a],e.indexOf(t)>=0||(r[t]=n[t]);return r}(n,e);if(Object.getOwnPropertySymbols){var o=Object.getOwnPropertySymbols(n);for(a=0;a<o.length;a++)t=o[a],e.indexOf(t)>=0||Object.prototype.propertyIsEnumerable.call(n,t)&&(r[t]=n[t])}return r}var s=Object(a.forwardRef)((function(n,e){var t=n.color,a=void 0===t?"currentColor":t,o=n.size,i=void 0===o?24:o,s=l(n,["color","size"]);return r.a.createElement("svg",A({ref:e,xmlns:"http://www.w3.org/2000/svg",width:i,height:i,viewBox:"0 0 24 24",fill:"none",stroke:a,strokeWidth:"2",strokeLinecap:"round",strokeLinejoin:"round"},s),r.a.createElement("polyline",{points:"20 6 9 17 4 12"}))}));s.propTypes={color:i.a.string,size:i.a.oneOfType([i.a.string,i.a.number])},s.displayName="Check",e.a=s},KmIZ:function(n,e,t){var a=t("LboF"),r=t("5dOd");"string"==typeof(r=r.__esModule?r.default:r)&&(r=[[n.i,r,""]]);var o={insert:"head",singleton:!1};a(r,o);n.exports=r.locals||{}},Mg8b:function(n,e