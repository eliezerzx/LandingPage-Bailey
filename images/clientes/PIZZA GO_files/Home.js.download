0;\n    font-size: 15px;\n    margin-bottom: 10px;\n}\n\n.redo_order-modal-infos {\n    margin-bottom: 10px;\n    font-size: 14px;\n}\n\n.redo_order-modal .redo_order-modal-input {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 5px;\n    padding: 10px;\n}\n\n.redo_order-modal .redo_order-modal-input input {\n    width: 160px;\n    height: 100%;\n    border: 1px solid rgba(0, 0, 0, 0.2);\n    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);\n    border-radius: 4px;\n    padding: 6px;\n}\n\n.redo_order-modal\n    .redo_order-modal-input\n    input[type="number"]::-webkit-inner-spin-button {\n    appearance: none;\n}\n\n.redo_order-modal-btn {\n    width: 100%;\n    height: 43px;\n    background-color: #4caf50;\n    border-radius: 4px;\n    border: 1px solid rgba(0, 0, 0, 0.1);\n    box-shadow: 0 1px 10px rgba(0, 0, 0, 0.05);\n    padding: 0 12px;\n    color: #fff;\n    margin: 15px auto 0;\n}\n\n.orders_loading > svg {\n    height: 25px;\n    width: 25px;\n    fill: #ed0407;\n}\n\n.redo_order-modal-order {\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 4px;\n    margin: 0;\n    padding: 0;\n    background-color: #ffffff80;\n    border: 1px solid #ed0407;\n    border-radius: 6px;\n}\n\n.redo_order-modal-order > strong {\n    text-align: center;\n    font-weight: 500;\n    color: #ffffff;\n    font-size: 15px;\n    background-color: #ed0407;\n    padding: 2px 4px;\n    margin: 0;\n    border-radius: 6px 6px 0 0;\n}\n\n.redo_order-modal-purchase {\n    font-size: 15px;\n    padding: 0 6px;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n    margin: 0;\n}\n\n.redo_order-modal-purchase > li {\n    padding-bottom: 4px;\n    display: flex;\n    gap: 10px;\n}\n\n.redo_order-modal-purchase > li:not(:last-child) {\n    border-bottom: 1px dashed #99999980;\n}\n\n.product_picture {\n    flex-shrink: 0;\n    width: 75px;\n    height: 75px;\n    border-radius: 4px;\n    border: 1px solid #00000010;\n    background-repeat: no-repeat;\n    background-position: center;\n    background-size: cover;\n}\n\n.redo_order-modal-product_infos {\n    display: flex;\n    justify-content: space-between;\n    gap: 15px;\n}\n\n.redo_order-modal-product_infos.disabled {\n    flex-direction: column;\n    justify-content: flex-start;\n    gap: 0;\n    background-color: #0000000a;\n    padding: 0 4px;\n    border-radius: 4px;\n    border: 1px solid #00000010;\n}\n\n.redo_order-modal-product_infos.disabled > s {\n    opacity: 0.8;\n}\n\n.redo_order-modal-product_aditionals {\n    display: flex;\n    flex-direction: column;\n    margin: 0;\n    padding: 0 0 0 20px;\n}\n\n.redo_order-modal-purchase_btn {\n    color: #ffffff;\n    text-align: center;\n    border-radius: 0 0 4px 4px;\n    border-top: solid 1px;\n    padding: 6px;\n    cursor: pointer;\n    transition: all 300ms ease-in-out;\n}\n\n.redo_order-modal-notice {\n    display: flex;\n    align-items: center;\n    gap: 5px;\n    line-height: 1;\n}\n\n.redo_order-modal-notice > svg {\n    color: #ed0407;\n    flex-shrink: 0;\n}\n\n.redo_order-modal-login_button {\n    color: #ffffff;\n    text-align: center;\n    font-weight: 500;\n    padding: 12px;\n    margin-top: 15px;\n    border-radius: 4px;\n    cursor: pointer;\n}\n'],sourceRoot:""}]),e.default=r},SXBe:function(n,e,t){"use strict";var a=t("q1tI"),r=t.n(a),o=(t("6gkv"),t("Ud0y")),i=t("h5Qr"),A=t("/MKj");e.a=function(n){var e=n.cart,t=n.color,a="inferior"===Object(A.c)((function(n){return n}),[]).configurations.menu_layout?"calc(100vh - 260px)":"calc(100vh - 200px)";return r.a.createElement("aside",{id:"aside_cart"},r.a.createElement("p",{className:"aside_cart-title"},r.a.createElement(o.a,{style:{color:t}}),"Carrinho"),r.a.createElement("ul",{className:"aside_cart-product_list",style:{maxHeight:a}},e.map((function(n){return r.a.createElement("li",{key:n.product_id,className:"aside_cart-product_card"},n.product_image&&r.a.createElement("div",{className:"product_pi