AAa;IACb,4BAA4B;IAC5B,SAAS;IACT,8BAA8B;IAC9B,oBAAoB;IACpB,mBAAmB;IACnB,WAAW;AACf;;AAEA;IACI;QACI,mBAAmB;IACvB;;IAEA;QACI,iBAAiB;IACrB;AACJ;;AAEA;;;IAGI,eAAe;IACf,kBAAkB;AACtB;;AAEA;IACI,SAAS;IACT,iBAAiB;IACjB,cAAc;IACd,YAAY;AAChB;;AAEA;IACI,eAAe;IACf,yBAAyB;IACzB,iBAAiB;IACjB,kBAAkB;IAClB,aAAa;IACb,mBAAmB;IACnB,uBAAuB;IACvB,QAAQ;IACR,YAAY;AAChB;;AAEA;IACI,yBAAyB;IACzB,gBAAgB;IAChB,aAAa;IACb,mBAAmB;IACnB,SAAS;AACb;;AAEA;;IAEI,WAAW;IACX,YAAY;AAChB;;AAEA;IACI;;;QAGI,eAAe;QACf,kBAAkB;IACtB;;IAEA;;;QAGI,WAAW;QACX,YAAY;IAChB;AACJ;;AAEA;IACI,8BAA8B;IAC9B,WAAW;IACX,YAAY;IACZ,eAAe;IACf,MAAM;IACN,OAAO;IACP,cAAc;AAClB;;AAEA;IACI,wBAAwB;IACxB,YAAY;IACZ,aAAa;IACb,kBAAkB;IAClB,QAAQ;IACR,SAAS;IACT,eAAe;IACf,gCAAgC;IAChC,eAAe;AACnB;;AAEA;IACI,mBAAmB;AACvB;;AAEA;IACI,mBAAmB;AACvB;;AAEA;IACI,mBAAmB;IACnB,YAAY;IACZ,mBAAmB;IACnB,iBAAiB;IACjB,mBAAmB;IACnB,kBAAkB;IAClB,iBAAiB;IACjB,YAAY;IACZ,eAAe;AACnB;;AAEA;IACI,YAAY;IACZ,WAAW;IACX,mBAAmB;IACnB,kBAAkB;IAClB,aAAa;IACb,mBAAmB;IACnB,uBAAuB;IACvB,iBAAiB;IACjB,yBAAyB;AAC7B;;AAEA;IACI,kBAAkB;AACtB;;AAEA;IACI,oCAAoC;IACpC,cAAc;IACd,aAAa;IACb,uBAAuB;IACvB,mBAAmB;IACnB,aAAa;IACb,kBAAkB;AACtB;;AAEA;IACI,oCAAoC;IACpC,cAAc;IACd,aAAa;IACb,uBAAuB;IACvB,mBAAmB;IACnB,WAAW;IACX,QAAQ;IACR,gBAAgB;IAChB,aAAa;IACb,kBAAkB;IAClB,eAAe;AACnB;;AAEA;IACI,aAAa;AACjB;;AAEA;IACI,aAAa;IACb,mBAAmB;IACnB,sBAAsB;IACtB,aAAa;IACb,iBAAiB;AACrB;;AAEA;IACI,gBAAgB;IAChB,iBAAiB;IACjB,kBAAkB;IAClB,oCAAoC;IACpC,qCAAqC;IACrC,cAAc;IACd,qBAAqB;IACrB,eAAe;IACf,gCAAgC;AACpC;;AAEA;IACI,cAAc;IACd,qBAAqB;AACzB;;AAEA;IACI,qCAAqC;IACrC,oCAAoC;IACpC,uBAAuB;AAC3B;;AAEA;IACI,qCAAqC;IACrC,oCAAoC;IACpC,uBAAuB;AAC3B;;AAEA;IACI;;;;OAIG;;IAEH;QACI,aAAa;IACjB;;IAEA;QACI,aAAa;QACb,sBAAsB;QACtB,eAAe;QACf,iBAAiB;QACjB,cAAc;QACd,UAAU;QACV,kBAAkB;IACtB;;IAEA;QACI,gCAAgC;IACpC;;IAEA;QACI,cAAc;QACd,aAAa;IACjB;;IAEA;QACI,gBAAgB;IACpB;;IAEA;;;QAGI,aAAa;IACjB;;IAEA;QACI,cAAc;QACd,sBAAsB;QACtB,eAAe;QACf,iBAAiB;QACjB,cAAc;IAClB;;IAEA;QACI,gBAAgB;QAChB,8BAA8B;IAClC;AACJ",sourcesContent:['.desktop-header {\n    display: none;\n}\n\n/* =====================================================================\n   Barra de ações da mesa — chip MESA + 4 botões card-style (3 brancos +\n   "Conta" vermelho destaque) inspirado no design POS tablet aprovado.\n   Mobile: chip some, só botão "Chamar garçom" full-width. */\n.qrtbl-action-bar {\n    display: flex; align-items: stretch; justify-content: flex-end;\n    gap: 12px;\n    width: calc(100% - 24px);\n    max-width: 1200px;\n    margin: 10px auto;\n    font-family: inherit;\n}\n.qrtbl-action-bar * { font-family: inherit; }\n\n/* Logo da loja no início da barra de ações — no mobile some, no tablet aparece */\n.qrtbl-logo {\n    display: none;\n    width: 56px; height: 56px;\n    border-radius: 50%;\n    background-position: center;\n    background-repeat: no-repeat;\n    background-size: cover;\n    background-color: #fff;\n    border: 2px solid #fff;\n    box-shadow: 0 2px 8px rgba(20, 22, 26, .12);\n    flex-shrink: 0;\n}\n.qrtbl-mesa-chip {\n    display: none;\n    flex-direction: row;\n    align-items: center; justify-content: center;\n    gap: 10px;\n    background: transparent;\n    border: none;\n    box-shadow: none;\n    padding: 0 12px;\n    line-height: 1;\n}\n.qrtbl-mesa-chip strong {\n    font-size: 10.5px; font-weight: 800;\n    color: #6a6f78; letter-spacing: .12em;\n    text-transform: uppercase;\n}\n.qrtbl-mesa-chip span {\n    font-size: 30px; font-weight: 800;\n    color: #15171a;\n    font-variant-numeric: tabular-nums;\n    letter-spacing: -.02em;\n}\n/* Grupo de botões — cada um é um card branco separado.\n   Sem container vermelho, sem divisores; gap entre os cards. */\n.qrtbl-action-btns {\n    display: flex;\n    gap: 8px;\n    background: transparent;\n    border-radius: 0;\n    overflow: visible;\n    box-shadow: none;\n}\n.qrtbl-act {\n    flex: 0 0 auto;\n    display: flex; flex-direction: column;\n    align-items: center; justify-content: center;\n    gap: 4px;\n    min-width: 78px; height: 64px;\n    padding: 6px 12px;\n    background: #fff;\n    color: #15171a;\n    border: 1.5px solid #eef0f3;\n    border-radius: 11px;\n    font-family: inherit;\n    font-size: 9px; font-weight: 800;\n    letter-spacing: .08em;\n    cursor: pointer;\n    transition: border-color .12s, background .12s, color .12s, transform .06s;\n    line-height: 1.1;\n    text-align: center;\n}\n.qrtbl-act:hover:not(:disabled) { border-color: #cfd3da; }\n.qrtbl-act:active:not(:disabled) { transform: translateY(1px); }\n.qrtbl-act:disabled { opacity: .8; cursor: progress; }\n.qrtbl-act .ic {\n    font-size: 22px; line-height: 1;\n    display: inline-flex; align-items: center; justify-content: center;\n    color: var(--primary);\n}\n.qrtbl-act .ic svg {\n    width: 22px; height: 22px;\n    stroke: var(--primary);\n    stroke-width: 2;\n}\n/* Botão CONTA (vermelho) — ícone fica branco pra contrastar */\n.qrtbl-act.qrtbl-act-conta .ic,\n.qrtbl-act.qrtbl-act-conta .ic svg { color: #fff; stroke: #fff; }\n/* Estados waiter (verde/laranja) — ícone branco também */\n.qrtbl-act.qrtbl-waiter-sent .ic svg,\n.qrtbl-act.qrtbl-waiter-error .ic svg { stroke: #fff; }\n.qrtbl-act .lbl {\n    text-transform: uppercase;\n    word-break: break-word;\n    max-width: 86px;\n}\n\n/* "Conta" — destaque visual com a cor PRIMÁRIA configurada da loja\n   (var(--primary), normalmente laranja). Texto + ícone brancos. */\n.qrtbl-act.qrtbl-act-conta {\n    background: var(--primary);\n    border-color: var(--primary);\n    color: #fff;\n    box-shadow: 0 6px 14px rgba(0, 0, 0, .15);\n}\n.qrtbl-act.qrtbl-act-conta:hover:not(:disabled) {\n    filter: brightness(0.92);\n}\n\n/* Estados do botão Chamar garçom */\n.qrtbl-act.qrtbl-waiter-sent { background: #16a34a; border-color: #16a34a; color: #fff; }\n.qrtbl-act.qrtbl-waiter-error { background: #f97316; border-color: #f97316; color: #fff; }\n\n/* Mobile (< 900px): chip some, só botão "Chamar garçom" full-width\n   sem o grupo. Os outros 3 botões viram visualmente irrelevantes\n   (mesma página já tem CARDÁPIO/CARRINHO no rodapé do mobile). */\n@media (max-width: 899px) {\n    .qrtbl-action-bar { justify-content: center; }\n    .qrtbl-mesa-chip { display: none; }\n    .qrtbl-action-btns {\n        width: 100%;\n        background: transparent;\n        box-shadow: none;\n    }\n    .qrtbl-act-cardapio,\n    .qrtbl-act-carrinho,\n    .qrtbl-act-qr,\n    .qrtbl-act-cart,\n    .qrtbl-act-conta { display: none; }\n    .qrtbl-act-waiter {\n        flex: 1;\n        flex-direction: row; gap: 8px;\n        background: #ef4444;\n        border-radius: 12px;\n        border: none;\n        padding: 13px 18px;\n        box-shadow: 0 4px 12px rgba(239, 68, 68, .3);\n    }\n    .qrtbl-act-waiter .ic { font-size: 16px; }\n    .qrtbl-act-waiter .lbl { font-size: 14px; max-width: none; }\n}\n\n/* Tablet landscape (>= 900px): esconde capa + nome/status/descrição em\n   TODOS os layouts de header possíveis (alternative, default, modern e\n   desktop-header). Mantém só o logotipo da loja num topbar enxuto.\n   Mobile mantém igual. */\n@media (min-width: 900px) {\n    /* Logo da loja aparece no início da barra de ações no tablet */\n    .qrtbl-logo {\n        display: block;\n        margin-right: auto; /* empurra mesa chip + botões pra direita */\n        align-self: center;\n    }\n\n    /* Banner/capa — esconde só os <header> dos wrappers de Home header.\n       NÃO usa `body header` cru porque isso afeta outras páginas que\n       usam <header> pra outros propósitos (ex: Additional page tem\n       <header id="additional-h"> com a imagem do produto). */\n    body .alternative-header > header,\n    body .default-header > header,\n    body .modern-header > header,\n    body .desktop-header > header { display: none !important; }\n\n    /* Containers — zera margins e fundo */\n    body .alternative-header,\n    body .default-header,\n    body .modern-header,\n    body .desktop-header { margin: 0 !important; }\n\n    /* Painel de informações — vira linha enxuta */\n    body .alternative-header .informations,\n    body .default-header .informations,\n    body .modern-header .informations,\n    body .desktop-header .informations {\n        background: transparent !important;\n        box-shadow: none !important;\n        margin: 0 !important;\n        padding: 10px 16px !important;\n        border-radius: 0 !important;\n        min-height: 0 !important;\n        align-items: center !important;\n        height: auto !important;\n        display: flex !important;\n    }\n\n    /* Esconde nome, descrição e status em TODOS os layouts.\n       Especificidade alta via `body` + alvos específicos pra vencer\n       qualquer regra padrão dos headers. */\n    body .informations .infos,\n    body .informations .name,\n    body .informations .description,\n    body .informations .time_status,\n    body .informations .status,\n    body .informations .delivery_time,\n    body .informations .text,\n    body .desktop-header .informations .header-infos .text,\n    body .desktop-header .informations .header-infos .time_status { display: none !important; }\n\n    /* Logo compacto pra topbar */\n    body .alternative-header .informations .logo,\n    body .default-header .informations .logo,\n    body .modern-header .informations .logo,\n    body .desktop-header .informations .header-infos .logo {\n        margin-top: 0 !important;\n        width: 56px !important;\n        height: 56px !important;\n        min-width: 56px !important;\n        min-height: 56px !important;\n        max-width: 56px !important;\n        max-height: 56px !important;\n        border-width: 3px !important;\n        border-radius: 50% !important;\n        flex-shrink: 0;\n        padding: 0 !important;\n    }\n\n    .qrtbl-mesa-chip { display: flex; flex-shrink: 0; }\n    /* Action bar absoluta no canto direito do topbar, alinhada com a logo */\n    .qrtbl-action-bar {\n        position: absolute;\n        top: 10px;\n        right: 16px;\n        margin: 0;\n        width: auto;\n        max-width: none;\n        z-index: 200;\n    }\n\n    /* Categorias na lateral esquerda + produtos em 2 colunas à direita.\n       Aplica só no tablet — mobile mantém o layout vertical original.\n       Visual baseado no design POS tablet (CardapioMesa.html). */\n    #home-main {\n        background: #f5f6f8;\n    }\n    #home-main .main_container {\n        display: grid;\n        grid-template-columns: 140px 1fr;\n        gap: 0;\n        align-items: start;\n        background: #f5f6f8;\n    }\n    /* Sidebar de categorias — fixa no canto esquerdo da viewport, fundo\n       branco, scroll interno se houver mais categorias que cabem.\n       position:fixed garante que a sidebar fique parada enquanto o\n       conteúdo principal scrolla. */\n    #home-main .main_container .category {\n        grid-column: 1;\n        grid-row: 1 / span 99;\n        position: fixed;\n        top: 0; left: 0; bottom: 0;\n        width: 140px;\n        margin: 0;\n        padding: 16px 10px;\n        background: #fff;\n        border-right: 1px solid #eef0f3;\n        overflow-y: auto;\n        z-index: 50;\n        box-sizing: border-box;\n    }\n    #home-main .main_container .category::-webkit-scrollbar { width: 4px; }\n    #home-main .main_container .category::-webkit-scrollbar-thumb { background: #e6e8ec; border-radius: 2px; }\n    /* Força Swiper a renderizar empilhado em coluna (vertical) */\n    #home-main .main_container .category .swiper {\n        height: auto !important;\n    }\n    #home-main .main_container .category .swiper-wrapper {\n        flex-direction: column !important;\n        transform: none !important;\n        gap: 8px;\n    }\n    #home-main .main_container .category .swiper-slide {\n        width: 100% !important;\n        height: auto !important;\n        margin: 0 !important;\n    }\n    /* Card de categoria — transparente, sem sombra; ativa fica vermelha */\n    #home-main .main_container .category .based-cat {\n        background: transparent !important;\n        border: none !important;\n        box-shadow: none !important;\n        border-radius: 14px !important;\n        padding: 12px 6px !important;\n        min-height: 84px;\n        color: #5d6470 !important;\n        gap: 6px;\n    }\n    #home-main .main_container .category .based-cat:hover {\n        background: #f5f6f8 !important;\n    }\n    #home-main .main_container .category .based-cat.active {\n        background: var(--primary) !important;\n        color: #fff !important;\n        box-shadow: 0 6px 14px rgba(0, 0, 0, .15) !important;\n    }\n    #home-main .main_container .category .based-cat.active .name-cat {\n        color: #fff !important;\n    }\n    /* Icone usa a cor primária configurada da loja (var(--primary)).\n       Quando ativo (vermelho), fica branco pra contrastar com o fundo. */\n    #home-main .main_container .category .based-cat .icon-cat {\n        width: 36px !important;\n        height: 36px !important;\n        background-color: var(--primary) !important;\n    }\n    #home-main .main_container .category .based-cat.active .icon-cat {\n        background-color: #fff !important;\n    }\n    #home-main .main_container .category .based-cat .name-cat {\n        font-size: 12px !important;\n        font-weight: 800 !important;\n        letter-spacing: .02em;\n        text-align: center;\n        line-height: 1.1;\n    }\n\n    /* Conteúdo principal — padding e fundo */\n    #home-main .main_container > .search-bar,\n    #home-main .main_container > #filter_bar-ward,\n    #home-main .main_container > .based-list {\n        grid-column: 2;\n        padding-left: 22px;\n        padding-right: 22px;\n    }\n\n    /* Search bar — o .search-bar inteiro vira o card branco, input\n       fica transparente dentro pra o ícone da lupa não estourar fora. */\n    #home-main .main_container > .search-bar {\n        margin: 14px 22px 0;\n        padding: 0 !important;\n        background: #fff !important;\n        border: 1px solid #eef0f3 !important;\n        border-radius: 11px !important;\n        position: relative !important;\n        display: flex;\n        align-items: center;\n        overflow: hidden;\n    }\n    #home-main .main_container > .search-bar input {\n        flex: 1;\n        background: transparent !important;\n        border: none !important;\n        border-radius: 0 !important;\n        padding: 12px 44px 12px 14px !important;\n        font-size: 14px !important;\n        outline: none !important;\n    }\n    /* Lupa fica colada no canto direito dentro do card */\n    #home-main .main_container > .search-bar svg {\n        position: absolute !important;\n        right: 14px !important;\n        top: 50% !important;\n        transform: translateY(-50%) !important;\n        color: #6a6f78;\n        pointer-events: none;\n        width: 18px; height: 18px;\n    }\n\n    /* Título da categoria — grande e bold (estilo .sec-head) */\n    #home-main .main_container > .based-list .title-list {\n        font-size: 24px;\n        font-weight: 800;\n        letter-spacing: -.02em;\n        color: #15171a !important;\n        margin: 14px 0 14px;\n    }\n\n    /* Lista de produtos em 2 colunas */\n    #home-main .main_container .based-list .list-vertical {\n        display: grid;\n        grid-template-columns: 1fr 1fr;\n        gap: 14px;\n        align-items: stretch;\n    }\n\n    /* No tablet, a barra CARDÁPIO/CARRINHO do rodapé some — os 2 botões\n       viram cards iguais aos outros (Chamar Garçom, QR, Conta) na topbar. */\n    #main-nav,\n    #main-nav.fixed_bottom { display: none !important; }\n\n    /* Sticky filter bar (Categorias dropdown + Pesquisar) que aparece\n       no scroll também some — sidebar de categorias + busca do topo\n       já cobrem essa função; sem isso a barra fica sobreposta na sidebar. */\n    #filter_bar-container { display: none !important; }\n\n    /* Botão FECHAR PEDIDO (#demand) fica no rodapé do conteúdo principal,\n       sem cobrir a sidebar (que tem width: 140px). Antes era left:0 e\n       cobria a sidebar inteira. margin-bottom: 0 cancela o inline style\n       (60-100px) que era pra empurrar pra cima do menu CARDÁPIO/CARRINHO\n       — mas como esse menu já foi escondido no tablet, não precisa do\n       espaço extra. */\n    #demand {\n        left: 140px !important;\n        width: calc(100% - 140px) !important;\n        bottom: 0 !important;\n        padding: 8px 16px !important;\n        margin-bottom: 0 !important;\n    }\n    #demand > button {\n        height: 56px !important;\n        max-width: 1200px;\n        margin: 0 auto;\n    }\n\n    /* Cards de produto — visual do design POS tablet: 92px image LEFT\n       + info à direita; card branco com borda + hover sombra. Override\n       o flex-direction: row-reverse padrão pra imagem ficar à esquerda.\n       IMPORTANTE: scopeado em .list-vertical pra NÃO afetar produtos\n       destacados (.list-horizontal, order_numb < 0) que usam layout em\n       carrossel column. */\n    #home-main .main_container .based-list .list-vertical .item.clickable-item {\n        flex-direction: row !important;\n        gap: 12px !important;\n        background: #fff !important;\n        border: 1px solid #eef0f3 !important;\n        border-radius: 14px !important;\n        padding: 10px !important;\n        margin-bottom: 0 !important;\n        box-shadow: none !important;\n        transition: border-color .12s, box-shadow .12s, transform .06s;\n        align-items: stretch;\n    }\n    #home-main .main_container .based-list .list-vertical .item.clickable-item:hover {\n        border-color: #cfd3da !important;\n        box-shadow: 0 8px 20px rgba(20, 22, 26, .06) !important;\n    }\n    #home-main .main_container .based-list .list-vertical .item .picture-i {\n        min-width: 92px !important;\n        min-height: 92px !important;\n        width: 92px !important;\n        height: 92px !important;\n        border-radius: 11px !important;\n        flex-shrink: 0;\n        background-color: #fdecec;\n        border: 1px solid #f3c2c2;\n    }\n    #home-main .main_container .based-list .list-vertical .item .based-t {\n        padding: 0 !important;\n        gap: 3px;\n    }\n    #home-main .main_container .based-list .list-vertical .item .based-t .title-i {\n        font-size: 15px !important;\n        font-weight: 800 !important;\n        color: #15171a !important;\n        line-height: 1.15;\n    }\n    #home-main .main_container .based-list .list-vertical .item .based-t .desc-i {\n        font-size: 11.5px !important;\n        color: #6a6f78 !important;\n        opacity: 1 !important;\n        font-weight: 500 !important;\n        line-height: 1.4;\n        margin-top: 2px !important;\n        display: -webkit-box;\n        -webkit-line-clamp: 3;\n        -webkit-box-orient: vertical;\n        overflow: hidden;\n    }\n    #home-main .main_container .based-list .list-vertical .item .based-t .price-i {\n        font-size: 14px !important;\n        font-weight: 800 !important;\n        color: #15171a !important;\n        margin-top: auto !important;\n        padding-top: 6px;\n        letter-spacing: -.01em;\n        font-variant-numeric: tabular-nums;\n    }\n}\n\n/* Modais (QR + Conta) — overlay escurecido + card centralizado */\n.qrtbl-modal-backdrop {\n    position: fixed; inset: 0;\n    background: rgba(20, 22, 26, .55);\n    backdrop-filter: blur(3px);\n    display: flex; align-items: center; justify-content: center;\n    z-index: 99999;\n    padding: 20px;\n    animation: qrtblFade .2s ease both;\n}\n@keyframes qrtblFade { from { opacity: 0; } to { opacity: 1; } }\n.qrtbl-modal {\n    background: #fff;\n    border-radius: 16px;\n    width: 100%; max-width: 360px;\n    padding: 22px 22px 18px;\n    box-shadow: 0 20px 50px rgba(0, 0, 0, .25);\n    position: relative;\n    text-align: center;\n}\n.qrtbl-modal-wide { max-width: 480px; text-align: left; }\n.qrtbl-modal-close {\n    position: absolute; top: 10px; right: 12px;\n    width: 32px; height: 32px;\n    background: #f5f6f8; border: none; border-radius: 50%;\n    font-size: 20px; font-weight: 700; color: #5d6470;\n    cursor: pointer; line-height: 1;\n}\n.qrtbl-modal-close:hover { background: #e6e8ec; color: #15171a; }\n.qrtbl-modal-title {\n    font-size: 18px; font-weight: 800; color: #15171a;\n    margin: 0 0 6px;\n}\n.qrtbl-modal-sub {\n    font-size: 13px; font-weight: 500; color: #5d6470;\n    margin: 0 0 14px; line-height: 1.4;\n}\n.qrtbl-modal-qr {\n    display: block; margin: 12px auto;\n    width: 220px; height: 220px;\n    border: 1px solid #eef0f3; border-radius: 8px;\n}\n.qrtbl-modal-url {\n    font-size: 11.5px; color: #6a6f78;\n    word-break: break-all; line-height: 1.3;\n    background: #f5f6f8; padding: 8px 10px; border-radius: 8px;\n    font-family: monospace;\n}\n\n/* Conta — agrupado por comanda + breakdown (subtotal/taxa/total) */\n.qrtbl-conta-loading {\n    text-align: center; padding: 20px 0;\n    color: #6a6f78; font-weight: 600;\n}\n.qrtbl-conta-comandas {\n    max-height: 45vh; overflow-y: auto;\n    margin-top: 8px;\n}\n.qrtbl-conta-comanda {\n    margin-bottom: 14px;\n}\n.qrtbl-conta-comanda:last-child { margin-bottom: 0; }\n.qrtbl-conta-comanda-head {\n    display: flex; align-items: baseline; justify-content: space-between;\n    gap: 8px;\n    padding: 8px 0;\n    border-bottom: 1px solid #eef0f3;\n    font-size: 12px;\n}\n.qrtbl-conta-comanda-head .lbl {\n    font-weight: 800; color: #6a6f78;\n    letter-spacing: .06em; text-transform: uppercase;\n}\n.qrtbl-conta-comanda-head .meta {\n    color: #6a6f78; font-weight: 600;\n    font-variant-numeric: tabular-nums;\n}\n.qrtbl-conta-list {\n    list-style: none; padding: 0; margin: 0;\n}\n.qrtbl-conta-item {\n    display: flex; align-items: baseline; gap: 8px;\n    padding: 8px 0;\n    border-bottom: 1px solid #f5f6f8;\n    font-size: 14px;\n}\n.qrtbl-conta-item:last-child { border-bottom: none; }\n.qrtbl-conta-item .qty {\n    flex-shrink: 0;\n    color: #ef4444; font-weight: 800;\n    min-width: 32px;\n}\n.qrtbl-conta-item .name { flex: 1; color: #15171a; font-weight: 600; }\n.qrtbl-conta-item .price {\n    color: #15171a; font-weight: 700;\n    font-variant-numeric: tabular-nums;\n}\n\n.qrtbl-conta-summary {\n    margin-top: 14px; padding-top: 12px;\n    border-top: 1px solid #eef0f3;\n}\n.qrtbl-conta-row {\n    display: flex; justify-content: space-between; align-items: baseline;\n    padding: 4px 0;\n    font-size: 13px;\n    color: #5d6470; font-weight: 600;\n}\n.qrtbl-conta-row span:last-child {\n    color: #15171a; font-weight: 700;\n    font-variant-numeric: tabular-nums;\n}\n.qrtbl-conta-total {\n    display: flex; justify-content: space-between; align-items: baseline;\n    margin-top: 8px; padding-top: 10px;\n    border-top: 2px solid #15171a;\n    font-size: 15px; font-weight: 700;\n    color: #15171a;\n}\n.qrtbl-conta-total strong {\n    font-size: 22px; font-weight: 900; color: #15803d;\n    font-variant-numeric: tabular-nums;\n}\n\n#filter_bar-ward {\n    height: 1px;\n    background-color: transparent;\n}\n\n#filter_bar-container {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    width: 100%;\n    padding: 10px;\n    background-color: var(--white);\n    border: 1px solid rgba(0, 0, 0, 0.1);\n    box-shadow: 0 1px 10px rgba(0, 0, 0, 0.05);\n    position: fixed;\n    z-index: 99999;\n    top: 0;\n    left: 0;\n}\n\n#filter_bar-container option {\n    background-color: red;\n}\n\n#filter_bar-container .filter-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 10px;\n    width: 100%;\n    height: 38px;\n}\n\n#filter_bar-container .filter-header .filter-categories {\n    flex-grow: 1;\n}\n\n#filter_bar-container .filter-input {\n    /* width: 50%; */\n    height: 36px;\n    padding: 5px 12px;\n    padding-right: 2px;\n    border-radius: 5px;\n}\n\n#filter_bar-container .filter-search-bar {\n    display: flex;\n    align-items: center;\n    height: 38px;\n    max-width: 50%;\n    background-color: var(--white);\n    border-radius: 5px;\n    border: 1px solid rgba(0, 0, 0, 0.2);\n    padding-right: 6px;\n}\n\n.features_buttons {\n    display: flex;\n    /* flex-direction: column; */\n    gap: 10px;\n    justify-content: space-between;\n    align-items: stretch;\n    margin-bottom: 15px;\n    width: 100%;\n}\n\n@media (max-width: 390px) {\n    .features_buttons {\n        margin-bottom: 10px;\n    }\n\n    .features_buttons:first-of-type {\n        margin-top: -10px;\n    }\n}\n\n.redo_order-button > p,\n.cashback-button > p,\n.features_buttons #open-fidelity_system {\n    font-size: 13px;\n    text-align: center;\n}\n\n.features_buttons #open-fidelity_system {\n    margin: 0;\n    padding: 12px 8px;\n    width: initial;\n    flex-grow: 1;\n}\n\n.redo_order-button {\n    cursor: pointer;\n    background-color: #ffffff;\n    padding: 12px 8px;\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 2px;\n    flex-grow: 1;\n}\n\n.redo_order-button > p {\n    text-transform: uppercase;\n    font-weight: 500;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n}\n\n.redo_order-button svg,\n.features_buttons #open-fidelity_system > svg {\n    width: 20px;\n    height: 20px;\n}\n\n@media (max-width: 400px) {\n    .redo_order-button > p,\n    .cashback-button > p,\n    .features_buttons #open-fidelity_system {\n        font-size: 12px;\n        text-align: center;\n    }\n\n    .redo_order-button svg,\n    .cashback-button svg,\n    .features_buttons #open-fidelity_system > svg {\n        width: 15px;\n        height: 15px;\n    }\n}\n\n.background-storeStatus-modal {\n    background: rgba(0, 0, 0, 0.5);\n    width: 100%;\n    height: 100%;\n    position: fixed;\n    top: 0;\n    left: 0;\n    z-index: 99999;\n}\n\n.storeStatus-modal {\n    width: calc(100% - 40px);\n    height: auto;\n    padding: 20px;\n    border-radius: 6px;\n    top: 50%;\n    left: 50%;\n    position: fixed;\n    transform: translate(-50%, -50%);\n    z-index: 999999;\n}\n\n.storeStatus-modal.red {\n    background: #f44336;\n}\n\n.storeStatus-modal.yellow {\n    background: #e27006;\n}\n\n.storeStatus-modal-close {\n    background: #f44336;\n    float: right;\n    margin-right: -20px;\n    margin-top: -60px;\n    padding: 7.5px 15px;\n    border-radius: 6px;\n    font-weight: bold;\n    color: white;\n    cursor: pointer;\n}\n\n.storeStatus-modal-header {\n    color: white;\n    width: 100%;\n    margin: 10px 0 20px;\n    border-radius: 6px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: bold;\n    text-transform: uppercase;\n}\n\n.storeStatus-modal-header > svg {\n    margin-right: 20px;\n}\n\n.storeStatus-modal-info {\n    background-color: rgba(0, 0, 0, 0.1);\n    color: #ffffff;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    padding: 10px;\n    border-radius: 2px;\n}\n\n.storeStatus-modal-btn {\n    background-color: rgba(0, 0, 0, 0.1);\n    color: #ffffff;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    width: 100%;\n    gap: 6px;\n    margin-top: 15px;\n    padding: 10px;\n    border-radius: 2px;\n    cursor: pointer;\n}\n\n#aside_cart {\n    display: none;\n}\n\nfooter {\n    display: flex;\n    align-items: center;\n    flex-direction: column;\n    padding: 20px;\n    margin-top: -60px;\n}\n\nfooter a {\n    margin-top: 10px;\n    padding: 6px 12px;\n    border-radius: 6px;\n    border: 1px solid rgba(0, 0, 0, 0.1);\n    background-color: rgba(0, 0, 0, 0.25);\n    color: #ffffff;\n    text-decoration: none;\n    font-size: 14px;\n    transition: all 0.3s ease-in-out;\n}\n\nfooter a:visited {\n    color: #ffffff;\n    text-decoration: none;\n}\n\nfooter a:hover {\n    border: 1px solid rgba(0, 0, 0, 0.25);\n    background-color: rgba(0, 0, 0, 0.4);\n    transform: scale(1.025);\n}\n\nfooter a:active {\n    border: 1px solid rgba(0, 0, 0, 0.25);\n    background-color: rgba(0, 0, 0, 0.4);\n    transform: scale(0.975);\n}\n\n@media (min-width: 1200px) {\n    /* #main-nav {\n        max-width: 80vw;\n        min-width: 1200px;\n        margin: 0 auto;\n    } */\n\n    #demand {\n        display: none;\n    }\n\n    #home-main {\n        display: flex;\n        box-sizing: border-box;\n        max-width: 80vw;\n        min-width: 1200px;\n        margin: 0 auto;\n        padding: 0;\n        position: relative;\n    }\n\n    #home-main .main_container {\n        width: calc(100% - 377px - 10px);\n    }\n\n    #aside_cart {\n        flex-shrink: 0;\n        display: flex;\n    }\n\n    #aside_cart #demand {\n        display: initial;\n    }\n\n    .modern-header,\n    .alternative-header,\n    .default-header {\n        display: none;\n    }\n\n    .desktop-header {\n        display: block;\n        box-sizing: border-box;\n        max-width: 80vw;\n        min-width: 1200px;\n        margin: 0 auto;\n    }\n\n    footer {\n        margin-top: 20px;\n        margin-bottom: 20px !important;\n    }\n}\n'],sourceRoot:""}]),e.default=r},pIdo:function(n,e,t){"use strict";t.r(e);var a=t("JPst"),r=t.n(a)()(!0);r.push([n.i,"#filter_bar-ward {\n    height: 1px;\n    background-color: transparent;\n}\n\n#filter_bar-container {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    width: 100%;\n    padding: 10px;\n    background-color: var(--white);\n    border: 1px solid rgba(0, 0, 0, 0.1);\n    box-shadow: 0 1px 10px rgba(0, 0, 0, 0.05);\n    position: fixed;\n    z-index: 99999;\n    top: 0;\n    left: 0;\n}\n\n#filter_bar-container option {\n    background-color: red;\n}\n\n#filter_bar-container .filter-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 10px;\n    width: 100%;\n    height: 38px;\n}\n\n#filter_bar-container .filter-header .filter-categories {\n    flex-grow: 1;\n}\n\n#filter_bar-con