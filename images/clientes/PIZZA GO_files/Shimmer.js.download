ush([n.i,".search-bar {\n    position: relative;\n}\n\n.search-bar input {\n    width: 100%;\n    padding: 15px;\n    padding-right: 64px;\n    border-radius: 4px;\n}\n\n.category {\n    width: 100%;\n    margin-top: 20px;\n    position: relative;\n}\n\n@media (max-width: 390px) {\n    .category {\n        margin-top: 10px;\n    }\n}\n\n.category .swiper-slide {\n    width: auto;\n    height: 100%;\n}\n\n.category .based-cat {\n    border-radius: 6px;\n    background-color: var(--white);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-direction: column;\n    padding: 15px;\n    border: 1px solid rgba(0, 0, 0, 0.1);\n    box-shadow: 0 1px 10px rgba(0, 0, 0, 0.05);\n    transition: all 0.2s;\n    cursor: pointer;\n}\n\n.category .based-cat .icon-cat {\n    width: 25px;\n    height: 25px;\n    background-size: cover;\n    background-position: center;\n    -webkit-mask-image: linear-gradient(transparent, transparent);\n    background-color: var(--primary);\n    transition: all 0.2s;\n}\n\n.category .based-cat .name-cat {\n    font-weight: 500;\n    font-size: 14px;\n    text-align: center;\n    margin-top: 5px;\n    color: var(--title);\n    transition: all 0.2s;\n}\n\n.category .based-cat.active {\n    background-color: var(--primary);\n}\n\n.category .based-cat.active .icon-cat {\n    background-color: var(--white);\n}\n\n.category .based-cat.active .name-cat {\n    color: var(--white);\n}\n","",{version:3,sources:["webpack://resources/js/system/components/Category/Layout/styles.css"],names:[],mappings:"AAAA;IACI,kBAAkB;AACtB;;AAEA;IACI,WAAW;IACX,aAAa;IACb,mBAAmB;IACnB,kBAAkB;AACtB;;AAEA;IACI,WAAW;IACX,gBAAgB;IAChB,kBAAkB;AACtB;;AAEA;IACI;QACI,gBAAgB;IACpB;AACJ;;AAEA;IACI,WAAW;IACX,YAAY;AAChB;;AAEA;IACI,kBAAkB;IAClB,8BAA8B;IAC9B,aAAa;IACb,mBAAmB;IACnB,uBAAuB;IACvB,sBAAsB;IACtB,aAAa;IACb,oCAAoC;IACpC,0CAA0C;IAC1C,oBAAoB;IACpB,eAAe;AACnB;;AAEA;IACI,WAAW;IACX,YAAY;IACZ,sBAAsB;IACtB,2BAA2B;IAC3B,6DAA6D;IAC7D,gCAAgC;IAChC,oBAAoB;AACxB;