\n.based-list .title-list.dropdown {\n    background-color: #ffffff;\n    display: flex;\n    align-items: center;\n    cursor: pointer;\n    border-radius: 6px;\n    padding: 10px 5px;\n}\n\n.based-list .list-horizontal {\n    width: 100%;\n    display: flex;\n    align-items: stretch;\n    gap: 10px;\n    overflow-x: auto;\n}\n\n.based-list .list-horizontal::-webkit-scrollbar {\n    width: 16px;\n    height: 16px;\n}\n\n.based-list .list-horizontal::-webkit-scrollbar-track {\n    background: var(--backgroundBg);\n}\n\n.based-list .list-horizontal::-webkit-scrollbar-thumb {\n    background-color: #aaaaaa;\n    border-radius: 100px;\n    border: 5px solid var(--backgroundBg);\n}\n\n.based-list .list-horizontal .item {\n    flex-direction: column;\n    min-height: 230px;\n    height: auto;\n    width: 160px;\n    margin-bottom: 5px;\n}\n\n.based-list .list-horizontal.clickable .item.clickable-item {\n    height: 100%;\n    gap: 5px;\n}\n\n/* .based-list .list-horizontal .item .product_tag,\n.based-list .list-horizontal.clickable .item.clickable-item .product_tag {\n    max-width: 140px;\n    overflow: hidden;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n} */\n\n.based-list .list-horizontal .item .picture-i {\n    min-width: 140px;\n    height: 160px;\n    box-shadow: inset 0px -50px 40px -45px #000000b0;\n}\n\n.based-list .list-horizontal.clickable .item.clickable-item .picture-i {\n    height: 120px;\n}\n\n.based-list .list-horizontal .item .picture-title-i {\n    min-width: 136px;\n    overflow: hidden;\n    color: #fff;\n    font-weight: 600;\n    text-align: center;\n    text-shadow: 0px 1px 2px #000000b0;\n    position: absolute;\n    bottom: 70px;\n}\n\n.based-list .list-horizontal.clickable .item.clickable-item .picture-title-i {\n    position: static;\n    max-height: fit-content;\n    color: #000000;\n    text-shadow: none;\n}\n\n.based-list .list-horizontal .item .based-t {\n    align-items: center;\n    text-align: center;\n    padding: 3px 0;\n}\n\n.based-list .list-horizontal.clickable .item.clickable-item .based-t {\n    justify-content: flex-end;\n}\n\n.based-list .list-horizontal .item .based-t .title-i {\n    width: 100%;\n    max-height: 36px;\n    /* white-space: nowrap;\n    text-overflow: ellipsis; */\n    overflow: hidden;\n}\n\n.based-list .list-horizontal .item .based-t .price-i {\n    margin: 0;\n}\n\n.based-list .list-horizontal .item .btn-added {\n    height: 28px;\n}\n\n/* Estilização para totem */\n\n@media (min-height: 1300px) {\n    .based-list .item {\n        margin-bottom: 0;\n        min-height: 140px;\n        height: fit-content;\n    }\n\n    .based-list .item .based-t {\n        justify-content: space-around;\n    }\n\n    .based-list .item .picture-i,\n    .based-list .list-horizontal.clickable .item.clickable-item .picture-i {\n        width: 185px;\n        height: 160px;\n    }\n\n    .based-list .item.disabled::before {\n        width: 186px;\n    }\n\n    .based-list .list-horizontal .item .picture-i {\n        min-width: 145px;\n    }\n\n    .list-vertical.tablet-style {\n        display: grid;\n        grid-template-columns: repeat(2, calc(50% - 5px));\n        gap: 10px;\n    }\n\n    #tablet-home .based-list .list-horizontal .item {\n        height: 250px;\n        width: 200px;\n    }\n\n    #tablet-home .based-list .list-horizontal .item .picture-title-i {\n        width: 185px;\n    }\n}\n\n/* Estilização para desktop */\n\n@media (min-width: 1100px) {\n    .list-vertical {\n        display: grid;\n        grid-template-columns: repeat(2, 1fr);\n        gap: 10px;\n    }\n\n    .based-list .item {\n        height: 100%;\n    }\n}\n","",{version:3,sources:["webpack://resources/js/system/components/List/Layout/styles.css"],names:[],mappings:"AAAA;IACI,WAAW;IACX,kBAAkB;IAClB,gBAAgB;AACpB;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,qBAAqB;IACrB,gBAAgB;IAChB,mBAAmB;IACnB,gBAAgB;AACpB;;AAEA;IACI,yBAAyB;IACzB,aAAa;IACb,mBAAmB;IACnB,eAAe;IACf,kBAAkB;IAClB,iBAAiB;AACrB;;AAEA;IACI,WA