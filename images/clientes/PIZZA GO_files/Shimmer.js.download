er;\n    padding: 0 2px;\n    transition: opacity 0.2s;\n    height: 100%;\n}\n\n.based-list .item .btn-added svg {\n    height: 16px;\n    stroke-width: 4px;\n}\n\n.based-list .item .btn-added:active {\n    opacity: 0.7;\n}\n\n.based-list .product_tag {\n    display: inline-block;\n    color: var(--white);\n    padding: 2px 4px;\n    font-size: 10px;\n    font-weight: 400;\n    border-radius: 6px;\n}\n\n.based-list .item.disabled {\n    position: relative;\n}\n\n.based-list .item.disabled * {\n    opacity: 0.55;\n}\n\n.based-list .item.disabled *,\na.disabled {\n    cursor: not-allowed;\n}\n\n.based-list .item.disabled::before {\n    box-sizing: border-box;\n    width: 92px;\n    padding: 4px 8px;\n    content: "ESGOTADO";\n    color: #ffffff;\n    background-color: #000000;\n    font-size: 12px;\n    font-weight: 400;\n    text-align: center;\n    position: absolute;\n    z-index: 9;\n    top: calc(50% - 11px);\n    transform: rotate(-20deg);\n    border: 1px solid #000000;\n    border-radius: 4px;\n    cursor: not-allowed;\n}\n\n.based-list .item.disabled .btn-added.disabled {\n    background-color: gray;\n}\n\n.based-list .list-horizontal .item.disabled::before {\n    width: calc(100% - 15px);\n    top: 30%;\n    transform: rotate(-15deg);\n}\n\n.based-list .list-horizontal .item.disabled .picture-title-i {\n    opacity: 0.85;\n}\n\n/* Layout dos card no totem */\n#tablet-home .based-list .list-horizontal .item.tablet-item {\n    height: fit-content;\n    justify-content: flex-end;\n    position: relative;\n}\n\n#tablet-home .based-list .list-horizontal .item.tablet-item .product_tag {\n    position: fixed;\n    top: 5px;\n}\n#tablet-home .based-list .list-horizontal .item.tablet-item .desc-i {\n    overflow: hidden;\n    white-space: nowrap;\n    text-overflow: ellipsis;\n    max-width: 100%;\n    margin-top: 0;\n}\n\n#tablet-home .based-list .list-horizontal .item.tablet-item .picture-title-i {\n    position: initial;\n    /* overflow: hidden;\n    white-space