n        font-size: 16px;\n    }\n}\n\n#cashback_modal .cashback_modal-header svg {\n    background-color: #f44336;\n    color: #ffffff;\n    border-radius: 4px;\n    padding: 3px;\n    cursor: pointer;\n}\n\n#cashback_modal .action_buttons {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    font-size: 14px;\n    margin: 10px 0 0;\n}\n\n#cashback_modal .action_buttons button {\n    cursor: pointer;\n    border: none;\n    transition: 0.2s;\n    padding: 8px 16px;\n    text-align: center;\n    color: #fff;\n    border-radius: 4px;\n}\n\n#cashback_modal .action_buttons .primary {\n    background: var(--primary);\n}\n","",{version:3,sources:["webpack://resources/js/system/components/CashbackSystem/styles.css"],names:[],mappings:"AAAA;IACI,eAAe;IACf,yBAAyB;IACzB,iBAAiB;IACjB,kBAAkB;IAClB,aAAa;IACb,mBAAmB;IACnB,uBAAuB;IACvB,QAAQ;IACR,YAAY;AAChB;;AAEA;IACI,WAAW;IACX,YAAY;AAChB;;AAEA;IACI,yBAAyB;IACzB,gBAAgB;IAChB,aAAa;IACb,mBAAmB;IACnB,QAAQ;AACZ;;AAEA;IACI,eAAe;IACf,gBAAgB;IAChB,kBAAkB;IAClB,0BAA0B;IAC1B,yBAAyB;IACzB,yBAAyB;IACzB,kBAAkB;IAClB,cAAc;AAClB;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,8BAA8B;IAC9B,WAAW;IACX,YAAY;IACZ,eAAe;IACf,MAAM;IACN,OAAO;IACP,YAAY;AAChB;;AAEA;IACI,mBAAmB;IACnB,sBAAsB;IACtB,YAAY;IACZ,gBAAgB;IAChB,gBAAgB;IAChB,aAAa;IACb,kBAAkB;IAClB,QAAQ;IACR,SAAS;IACT,eAAe;IACf,gCAAgC;IAChC,aAAa;AACjB;;AAEA;IACI;QACI,gBAAgB;IACpB;AACJ;;AAEA;IACI,mBAAmB;IACnB,YAAY;IACZ,WAAW;IACX,kBAAkB;IAClB,kBAAkB;IAClB,aAAa;IACb,mBAAmB;IACnB,8BAA8B;IAC9B,yBAAyB;IACzB,gBAAgB;IAChB,eAAe;AACnB;;AAEA;IACI;QACI,eAAe;IACnB;AACJ;;AAEA;IACI,yBAAyB;IACzB,cAAc;IACd,kBAAkB;IAClB,YAAY;IACZ,eAAe;AACnB;;AAEA;IACI,aAAa;IACb,mBAAmB;IACnB,uBAAuB;IACvB,SAAS;IACT,eAAe;IACf,gBAAgB;AACpB;;AAEA;IACI,eAAe;IACf,YAAY;IACZ,gBAAgB;IAChB,iBAAiB;IACjB,kBAAkB;IAClB,WAAW;IACX,kBAAkB;AACtB;;AAEA;IACI,0BAA0B;AAC9B",sourcesContent:[".cashback-button {\n    cursor: pointer;\n    background-color: #ffffff;\n    padding: 12px 8px;\n    border-radius: 6px;\n    display: fl