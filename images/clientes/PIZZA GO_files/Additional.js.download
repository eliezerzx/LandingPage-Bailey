0;\n}\n\n.title-o {\n    text-transform: uppercase;\n    font-weight: 600;\n    font-size: 22px;\n    text-align: left;\n}\n\n.optional-tag {\n    color: white;\n    font-size: 12px;\n    font-weight: 400;\n    padding: 4px 0;\n}\n\n.optional-tag span {\n    padding: 2px 4px;\n    border-radius: 6px;\n}\n\n.optional-tag .not-required {\n    background-color: gray;\n}\n\n.optional-tag .required {\n    background-color: #f44336;\n}\n\n.desc-o {\n    opacity: 0.6;\n    text-align: left;\n    font-size: 16px;\n    font-weight: 300;\n    margin-bottom: 15px;\n}\n\n.checkbox-o {\n    width: 100%;\n    position: relative;\n}\n\n.checkbox-o label {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n}\n\n.checkbox-o input {\n    opacity: 0;\n    display: none;\n}\n\n.checkbox-o label .checked {\n    height: 35px;\n    width: 35px;\n    border-radius: 100%;\n    background-color: var(--white);\n    border: 1px solid rgba(0, 0, 0, 0.2);\n    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n}\n\n.checkbox-o label .checked svg {\n    height: 18px;\n    stroke-width: 4px;\n    color: #fff;\n}\n\n.checkbox-o input:checked + label .checked {\n    background-color: var(--green);\n    border: 1px solid rgba(0, 0, 0, 0.1);\n    box-shadow: 0 1px 10px rgba(0, 0, 0, 0.1);\n}\n\n.checkbox-o label .text-c .title-c {\n    font-size: 17px;\n    font-weight: 500;\n}\n\n.checkbox-o label .text-c .desc-c {\n    opacity: 0.8;\n    font-weight: 200;\n    font-size: 14px;\n    margin-left: 3px;\n}\n\n.checkbox-o label .price-c {\n    font-weight: 500;\n    font-size: 12px;\n    margin-left: 6px;\n    color: var(--priceItem);\n}\n\n.more-less-additional {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n}\n\n.more-less-additional .btns {\n    display: flex;\n}\n\n.more-less-additional .btns div {\n    padding: 7px;\n    border-radius: 5px;\n    max-width: 40px;\n    max-height: 40px;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    margin: 5px;\n    font-size: 16px;\n    font-weight: bold;\n}\n\n.more-less-additional .btns input {\n    width: 50px;\n    text-align: center;\n    border: 1px solid rgba(0, 0, 0, 0.1);\n    border-radius: 4px;\n}\n\n.more-less-additional .btns input[type="number"]::-webkit-inner-spin-button {\n    appearance: none;\n}\n\n.more-less-additional .infos-c .title {\n    font-weight: 500;\n    font-size: 17px;\n}\n\n.more-less-additional .infos-c .desc {\n    font-weight: 200;\n    font-size: 14px;\n    margin: 0 0 0 3px !important;\n}\n\n.more-less-additional .infos-c .price {\n    font-weight: 500;\n    font-size: 12px;\n    margin: 0 0 0 6px !important;\n    color: var(--priceItem);\n}\n\n#optional .input-group:not(:last-child),\n#optional .more-less-additional:not(:last-child) {\n    border-bottom: 1px solid rgba(0, 0, 0, 0.07);\n}\n\n#optional.inactive #add-0 {\n    opacity: 0.5;\n    cursor: not-allowed;\n}\n\n/* ============================================================\n   V2 — foto à esquerda em cada item de complemento.\n   .opt-v2-photo é um square 64x64 com cover-fit; placeholder\n   cinza quando o item não tem foto cadastrada.\n   ============================================================ */\n.opt-v2-photo {\n    width: 56px;\n    height: 56px;\n    flex-shrink: 0;\n    border-radius: 8px;\n    background-color: #f1f3f5;\n    background-position: center;\n    background-size: cover;\n    background-repeat: no-repeat;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: #cbd5e1;\n    font-size: 20px;\n}\n.opt-v2-photo-ph {\n    opacity: .55;\n}\n\n/* multiple — a label do checkbox vira flex pra encaixar foto à esquerda\n   do text-c. Mantemos o checked à direita. */\n.opt-v2-item .checkbox-o label {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n}\n.opt-v2-item .checkbox-o label .text-c {\n    flex: 1;\n    min-width: 0;\n}\n\n/* add (more-less) — coloca foto + infos + btns na mesma linha */\n.more-less-additional.opt-v2-item {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n}\n.more-less-additional.opt-v2-item .infos-c {\n    flex: 1;\n    min-width: 0;\n}\n',"",{version:3,sources:["webpack://resources/js/system/components/OptionalV2/Layout/styles.css"],names:[],mappings:"AAAA;IACI,gBAAgB;IAChB,gBAAgB;AACpB;;AAEA;IACI,8BAA8B;IAC9B,kBAAkB;AACtB;;AAEA;IACI,0BAA0B;AAC9B;;AAEA;IACI,kBAAkB;AACtB;;AAEA;IACI,0BAA0B;AAC9B;;AAEA;IACI,oBAAoB;AACxB;;AAEA;IACI,SAAS;AACb;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,yBAAyB;IACzB,gBAAgB;IAChB,eAAe;IACf,gBAAgB;AACpB;;AAEA;IACI,YAAY;IACZ,eAAe;IACf,gBAAgB;IAChB,cAAc;AAClB;;AAEA;IACI,gBAAgB;IAChB,kBAAkB;AACtB;;AAEA;IACI,sBAAsB;AAC1B;;AAEA;IACI,yBAAyB;AAC7B;;AAEA;IACI,YAAY;IACZ,gBAAgB;IAChB,eAAe;IACf,gBAAgB;IAChB,mBAAmB;AACvB;;AAEA;IACI,WAAW;IACX,kBAAkB;AACtB;;AAEA;IACI,aAAa;IACb,8BAA8B;IAC9B,mBAAmB;AACvB;;AAEA;IACI,UAAU;IACV,aAAa;AACjB;;AAEA;IACI,YAAY;IACZ,WAAW;IACX,mBAAmB;IACnB,8BAA8B;IAC9B,oCAAoC;IACpC,wCAAwC;IACxC,aAAa;IACb,mBAAmB;IACnB,uBAAuB;IACvB,cAAc;AAClB;;AAEA;IACI,YAAY;IACZ,iBAAiB;IACjB,WAAW;AACf;;AAEA;IACI,8BAA8B;IAC9B,oCAAoC;IACpC,yCAAyC;AAC7C;;AAEA;IACI,eAAe;IACf,gBAAgB;AACpB;;AAEA;IACI,YAAY;IACZ,gBAAgB;IAChB,eAAe;IACf,gBAAgB;AACpB;;AAEA;IACI,gBAAgB;IAChB,eAAe;IACf,gBAAgB;IAChB,uBAAuB;AAC3B;;AAEA;IACI,aAAa;IACb,8BAA8B;IAC9B,mBAAmB;AACvB;;AAEA;IACI,aAAa;AACjB;;AAEA;IACI,YAAY;IACZ,kBAAkB;IAClB,eAAe;IACf,gBAAgB;IAChB,aAAa;IACb,uBAAuB;IACvB,mBAAmB;IACnB,WAAW;IACX,eAAe;IACf,iBAAiB;AACrB;;AAEA;IACI,WAAW;IACX,kBAAkB;IAClB,oCAAoC;IACpC,kBAAkB;AACtB;;AAEA;IACI,gBAAgB;AACpB;;AAEA;IACI,gBAAgB;IAChB,eAAe;AACnB;;AAEA;IACI,gBAAgB;IAChB,eAAe;IACf,4BAA4B;AAChC;;AAEA;IACI,gBAAgB;IAChB,eAAe;IACf,4BAA4B;IAC5B,uBAAuB;AAC3B;;AAEA;;IAEI,4CAA4C;AAChD;;AAEA;IACI,YAAY;IACZ,mBAAmB;AACvB;;AAEA;;;;iEAIiE;AACjE;IACI,WAAW;IACX,YAAY;IACZ,cAAc;IACd,kBAAkB;IAClB,yBAAyB;IACzB,2BAA2B;IAC3B,sBAAsB;IACtB,4BAA4B;IAC5B,oBAA